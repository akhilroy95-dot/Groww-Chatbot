# Active provider and model (the model is read from .env, never hard-coded)
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b

# Groq (default)
GROQ_API_KEY=

# Optional providers — only the active provider needs a key
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# Optional overrides
LOG_LEVEL=INFO
